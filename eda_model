import numpy as np
import matplotlib.pyplot as plt

correlation_columns = ['survived', 'pclass', 'age', 'sibsp', 'parch', 'fare']
df_corr = df[correlation_columns]

# Compute the correlation matrix
corr_matrix = df_corr.corr()

# Generate a heatmap
plt.figure(figsize=(8, 6))
sns.heatmap(corr_matrix, annot=True, cmap='coolwarm', fmt='.2f', linewidths=.5)
plt.title('Correlation Matrix of Numeric Features')
plt.show()


# Identify the two strongest correlations (largest absolute off-diagonal coefficients)

# Create a mask to exclude self-correlations (diagonal) and duplicate pairs
mask = np.triu(np.ones_like(corr_matrix, dtype=bool))

# Get the absolute values of the off-diagonal correlations
off_diagonal_corr = corr_matrix.abs().mask(mask)

# Stack to get a Series and sort to find the largest absolute correlations
sorted_corr = off_diagonal_corr.unstack().sort_values(ascending=False)

print("\nTwo strongest off-diagonal correlations:")
# Get the top 2 unique pairs
top_2_corr = []
for (col1, col2), value in sorted_corr.items():
    if col1 != col2 and (col2, col1, value) not in top_2_corr: # Ensure unique pairs and not self-correlation
        top_2_corr.append((col1, col2, value))
        if len(top_2_corr) == 2:
            break

for col1, col2, value in top_2_corr:
    original_corr_value = corr_matrix.loc[col1, col2]
    print(f"- {col1} and {col2}: Correlation = {original_corr_value:.2f} (Absolute = {value:.2f})")


