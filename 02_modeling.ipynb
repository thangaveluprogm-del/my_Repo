print(f"SMOTE training set shape: {X_train_smote.shape}, {y_train_smote.shape}")
print("SMOTE training set class distribution:\n", y_train_smote.value_counts(normalize=True))

print("--- Training Logistic Regression with SMOTE Data ---")
log_reg_smote_model = LogisticRegression(random_state=42, solver='liblinear')
log_reg_smote_model.fit(X_train_smote, y_train_smote)
print("Logistic Regression (SMOTE) model trained successfully.")

# Evaluate and store results
results.append(evaluate_model(log_reg_smote_model, X_test_processed, y_test, 'Logistic Regression (SMOTE)'))

comparison_df = pd.DataFrame(results)
display(comparison_df.set_index('Model'))

from sklearn.model_selection import GridSearchCV
from sklearn.ensemble import RandomForestClassifier

# Define the parameter grid to search
param_grid = {
    'n_estimators': [50, 100, 150],
    'max_depth': [None, 10, 20],
    'max_features': ['sqrt', 'log2', 0.8]
}

# Initialize the Random Forest Classifier with oob_score=True
# The random_state ensures reproducibility
rf_grid_model = RandomForestClassifier(random_state=42, oob_score=True)

# Initialize GridSearchCV
# 'accuracy' is used as the scoring metric for simplicity, though for imbalanced data, other metrics like 'f1' or 'roc_auc' might be preferred.
# cv=5 means 5-fold cross-validation.
# n_jobs=-1 uses all available CPU cores.
print("--- Starting GridSearchCV for Random Forest ---")
grid_search = GridSearchCV(estimator=rf_grid_model, param_grid=param_grid, cv=5, scoring='accuracy', n_jobs=-1, verbose=1)

# Fit GridSearchCV to the training data
grid_search.fit(X_train_processed, y_train)
print("GridSearchCV completed successfully.")

# Report the best parameters and the corresponding OOB score
print("\nBest parameters found:", grid_search.best_params_)

# Retrieve the best estimator
best_rf_estimator = grid_search.best_estimator_

# Check if oob_score is available and print it
if hasattr(best_rf_estimator, 'oob_score_') and best_rf_estimator.oob_score_ is not None:
    print(f"Best OOB score: {best_rf_estimator.oob_score_:.4f}")
else:
    print("OOB score not available for the best estimator.")

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Prepare data for regression task
# Features to exclude from X: 'survived' (target for classification), 'fare' (target for regression),
# 'age_group', 'age_standardized', 'fare_standardized', 'alive' (proxies/derived).
regression_features = ['pclass', 'sex', 'age', 'sibsp', 'parch', 'embarked', 'embark_town']

X_reg = df[regression_features]
y_reg = df['fare']

# Split data into training and testing sets for regression
X_train_reg, X_test_reg, y_train_reg, y_test_reg = train_test_split(X_reg, y_reg, test_size=0.2, random_state=42)

print(f"X_train_reg shape: {X_train_reg.shape}")
print(f"X_test_reg shape: {X_test_reg.shape}")
print(f"y_train_reg shape: {y_train_reg.shape}")
print(f"y_test_reg shape: {y_test_reg.shape}")
# Define numeric and categorical features for regression preprocessing
# 'pclass' is treated as categorical for encoding, though it has numerical values.
numeric_features_reg = ['age', 'sibsp', 'parch']
categorical_features_reg = ['pclass', 'sex', 'embarked', 'embark_town']

# Create preprocessing pipelines
numeric_transformer_reg = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='median')),
    ('scaler', StandardScaler())
])

categorical_transformer_reg = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='most_frequent')),
    ('onehot', OneHotEncoder(handle_unknown='ignore'))
])

# Create a preprocessor object using ColumnTransformer for regression
preprocessor_reg = ColumnTransformer(
    transformers=[
        ('num', numeric_transformer_reg, numeric_features_reg),
        ('cat', categorical_transformer_reg, categorical_features_reg)
    ],
    remainder='drop'
)

# Create the full regression pipeline with preprocessing and Linear Regression model
regression_pipeline = Pipeline(steps=[
    ('preprocessor', preprocessor_reg),
    ('regressor', LinearRegression())
])

print("--- Training Linear Regression Model with Preprocessing Pipeline ---")
regression_pipeline.fit(X_train_reg, y_train_reg)
print("Linear Regression model trained successfully.")

# Make predictions on the test set
y_pred_reg = regression_pipeline.predict(X_test_reg)

# Calculate evaluation metrics
mae = mean_absolute_error(y_test_reg, y_pred_reg)
rmse = np.sqrt(mean_squared_error(y_test_reg, y_pred_reg))
r2 = r2_score(y_test_reg, y_pred_reg)

# Calculate Adjusted R-squared
n = X_test_reg.shape[0]  # Number of observations
p = X_train_reg.shape[1]  # Number of predictors (after one-hot encoding for X_train_processed)
adj_r2 = 1 - (1-r2) * (n-1) / (n-p-1)

print("--- Regression Model Evaluation ---")
print(f"Mean Absolute Error (MAE): {mae:.2f}")
print(f"Root Mean Squared Error (RMSE): {rmse:.2f}")
print(f"R-squared (R²): {r2:.2f}")
print(f"Adjusted R-squared: {adj_r2:.2f}")

# Generate Residual Plot
residuals = y_test_reg - y_pred_reg

plt.figure(figsize=(10, 6))
sns.scatterplot(x=y_pred_reg, y=residuals, alpha=0.7)
plt.axhline(y=0, color='r', linestyle='--', linewidth=2)
plt.xlabel('Predicted Fare')
plt.ylabel('Residuals')
plt.title('Residual Plot')
plt.grid(True, linestyle='--', alpha=0.7)
plt.show()


regression_metrics_df = pd.DataFrame({
    'Metric': ['MAE', 'RMSE', 'R²', 'Adjusted R²'],
    'Value': [mae, rmse, r2, adj_r2]
})
display(regression_metrics_df.set_index('Metric'))

import joblib
import pandas as pd
from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.linear_model import LogisticRegression
from imblearn.over_sampling import SMOTE
from imblearn.pipeline import Pipeline as ImbPipeline # Use ImbPipeline for combining SMOTE

# Re-define the features used in the best model (Logistic Regression with SMOTE)
# These are the columns expected by the preprocessor for raw input.
features_for_model = ['pclass', 'sex', 'age', 'sibsp', 'parch', 'fare', 'embark_town']

# Define numeric and categorical features for the ColumnTransformer
numeric_features = ['age', 'sibsp', 'parch', 'fare']
categorical_features = ['pclass', 'sex', 'embark_town']

# Create preprocessing pipelines for numerical and categorical features
numeric_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='median')),
    ('scaler', StandardScaler())
])

categorical_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='most_frequent')),
    ('onehot', OneHotEncoder(handle_unknown='ignore'))
])

# Create the ColumnTransformer (preprocessor)
preprocessor = ColumnTransformer(
    transformers=[
        ('num', numeric_transformer, numeric_features),
        ('cat', categorical_transformer, categorical_features)
    ],
    remainder='drop' # Drop any columns not specified
)

# Create the full pipeline including preprocessor, SMOTE, and the classifier
# Use ImbPipeline from imblearn to correctly integrate SMOTE into the pipeline.
full_pipeline_smote = ImbPipeline(steps=[
    ('preprocessor', preprocessor),
    ('smote', SMOTE(random_state=42)),
    ('classifier', LogisticRegression(random_state=42, solver='liblinear'))
])

# Fit the full pipeline on the original (but selected features) training data and target
# X_train is the original DataFrame containing all columns before filtering for X_train_filtered
full_pipeline_smote.fit(X_train[features_for_model], y_train)


joblib.dump(full_pipeline_smote, 'best_classification_pipeline.joblib')

print("Best classification pipeline (Logistic Regression with SMOTE) saved successfully!")

import joblib
import pandas as pd

loaded_pipeline = joblib.load('best_classification_pipeline.joblib')

print("Pipeline reloaded successfully!")


sample_raw_data = X_test[features_for_model].sample(5, random_state=42)

print("\nRaw input data sample:")
display(sample_raw_data)

predictions = loaded_pipeline.predict(sample_raw_data)

