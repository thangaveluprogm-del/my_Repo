from pydantic import BaseModel, Field

# Define the Pydantic model for the output schema
class AnswerSchema(BaseModel):
    answer: str = Field(description="The concise answer to the user's question.")
    sources: list[str] = Field(description="List of chunk/document IDs (metadata 'source' field) used to formulate the answer. Empty for general_question answers.")
    confidence: float = Field(description="A confidence score for the answer, between 0 and 1. Fixed to 1.0 in mock mode.")

print("AnswerSchema Pydantic model defined.")

