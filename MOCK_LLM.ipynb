import os

docs_dir = "docs"
os.makedirs(docs_dir, exist_ok=True)

# Check if at least 8 documents following the 'doc_XX.txt' pattern exist
existing_docs_count = len([f for f in os.listdir(docs_dir) if f.startswith('doc_') and f.endswith('.txt')])

if existing_docs_count < 8:
    print(f"Less than 8 documents found in '{docs_dir}/'. Creating dummy documents.")
    for i in range(1, 9):
        file_name = f"doc_{i:02d}.txt" # Ensures 0-padding for consistency (e.g., doc_01.txt)
        with open(os.path.join(docs_dir, file_name), "w") as f:
            f.write(f"This is document number {i}. It contains some sample text for processing. " * 20)
    print(f"Created or ensured 8 dummy documents in '{docs_dir}/'.")
else:
    print(f"At least 8 documents already exist in '{docs_dir}/'. Skipping dummy document creation.")

from langchain_community.document_loaders import DirectoryLoader, TextLoader
from langchain_core.documents import Document


loader = DirectoryLoader(docs_dir, glob="**/doc_*.txt", loader_cls=TextLoader, loader_kwargs={'encoding': 'latin-1'})
documents = loader.load()

print(f"Loaded {len(documents)} documents.")

if documents:
    print("\nContent of the first document:")
    print(documents[0].page_content[:200] + "...")
else:
    print("No documents loaded.")

from langchain_text_splitters import RecursiveCharacterTextSplitter


text_splitter = RecursiveCharacterTextSplitter(
    chunk_size=500, # Max size of each chunk
    chunk_overlap=50, # Overlap between chunks to maintain context
    separators=["\n\n", "\n", ".", " ", ""]
)


chunks = text_splitter.split_documents(documents)

print(f"Split {len(documents)} documents into {len(chunks)} chunks.")

if chunks:
    print("\nContent of the first chunk:")
    print(chunks[0].page_content)
else:
    print("No chunks created.")


from langchain_community.embeddings import SentenceTransformerEmbeddings


embedding_function = SentenceTransformerEmbeddings(model_name="all-MiniLM-L6-v2")

print("Embedding model initialized: all-MiniLM-L6-v2")


from langchain_community.vectorstores import Chroma

vectorstore = Chroma.from_documents(
    documents=chunks,
    embedding=embedding_function,
    persist_directory="./chroma_db"
)


vectorstore.persist()
print("ChromaDB collection created and saved to './chroma_db'.")
print(f"Number of embeddings stored: {vectorstore._collection.count()}")


import os
from typing import TypedDict, Literal
from langgraph.graph import StateGraph, END
from langchain_core.documents import Document


MOCK_LLM = 1 # Set to 1 for mock mode (graded baseline), 0 for real LLM (optional extension)


class GraphState(TypedDict):
    """Represents the state of our graph."""
    question: str
    classification: Literal["policy_question", "general_question", "" ] # Added "" as a default or initial state
    documents: list[Document]
    answer: str

print("GraphState defined.")
print(f"MOCK_LLM is set to: {MOCK_LLM}")


def classify_intent(state: GraphState) -> GraphState:
    question = state["question"].lower()
    print(f"\n---Classifying intent for: '{question}'---")

    if MOCK_LLM == 1:
        # Mock mode: Keyword heuristic
        policy_keywords = [
            "delivery", "return", "refund", "membership",
            "tracking", "cancel", "gift card", "support hours"
        ]
        if any(keyword in question for keyword in policy_keywords):
            classification = "policy_question"
        else:
            classification = "general_question"
        print(f"Mock Classification: {classification}")
        return {"classification": classification}
    else:
       
        print("Real LLM classification not implemented for this exercise. Falling back to mock.")
       
        policy_keywords = [
            "delivery", "return", "refund", "membership",
            "tracking", "cancel", "gift card", "support hours"
        ]
        if any(keyword in question for keyword in policy_keywords):
            classification = "policy_question"
        else:
            classification = "general_question"
        print(f"Fallback Mock Classification: {classification}")
        return {"classification": classification}

print("classify_intent node implemented.")

def retrieve_and_answer(state: GraphState) -> GraphState:
    question = state["question"]
    print(f"\n---Retrieving and Answering for policy question: '{question}'---")

   
    retrieved_docs = vectorstore.similarity_search(question, k=3)
    print(f"Retrieved {len(retrieved_docs)} documents.")

    if MOCK_LLM == 1:
       
        if retrieved_docs:
            top_chunk_snippet = retrieved_docs[0].page_content[:200] + "..." # Short excerpt
            answer = f"Based on the retrieved context: {top_chunk_snippet}"
        else:
            answer = "No relevant policy information found in the knowledge base."
        print(f"Mock Answer: {answer}")
        return {"documents": retrieved_docs, "answer": answer}
    else:
        print("Real LLM answer generation not implemented for this exercise. Falling back to mock.")
        if retrieved_docs:
            top_chunk_snippet = retrieved_docs[0].page_content[:200] + "..."
            answer = f"Based on the retrieved context: {top_chunk_snippet}"
        else:
            answer = "No relevant policy information found in the knowledge base."
        print(f"Fallback Mock Answer: {answer}")
        return {"documents": retrieved_docs, "answer": answer}

print("retrieve_and_answer node implemented.")


def direct_answer(state: GraphState) -> GraphState:
    question = state["question"]
    print(f"\n---Providing direct answer for general question: '{question}'---")

    if MOCK_LLM == 1:
        answer = "I can only answer questions about Zepto policies right now."
        print(f"Mock Answer: {answer}")
        return {"answer": answer}
    else:
        
        print("Real LLM direct answer not implemented for this exercise. Falling back to mock.")
        answer = "I can only answer questions about Zepto policies right now."
        print(f"Fallback Mock Answer: {answer}")
        return {"answer": answer}

print("direct_answer node implemented.")



workflow = StateGraph(GraphState)


workflow.add_node("classify_intent", classify_intent)
workflow.add_node("retrieve_and_answer", retrieve_and_answer)
workflow.add_node("direct_answer", direct_answer)


workflow.set_entry_point("classify_intent")


workflow.add_conditional_edges(
    "classify_intent", # Source node
