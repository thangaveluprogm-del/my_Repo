import os

docs_dir = "docs"
os.makedirs(docs_dir, exist_ok=True)

# Check if at least 8 documents following the 'doc_XX.txt' pattern exist
existing_docs_count = len([f for f in os.listdir(docs_dir) if f.startswith('doc_') and f.endswith('.txt')])

if existing_docs_count < 8:
    print(f"Less than 8 documents found in '{docs_dir}/'. Creating dummy documents.")
    for i in range(1, 9):
        file_name = f"doc_{i:02d}.txt" # Ensures 0-padding for consistency (e.g., doc_01.txt)
        with open(os.path.join(docs_dir, file_name), "w") as f:
            f.write(f"This is document number {i}. It contains some sample text for processing. " * 20)
    print(f"Created or ensured 8 dummy documents in '{docs_dir}/'.")
else:
    print(f"At least 8 documents already exist in '{docs_dir}/'. Skipping dummy document creation.")

from langchain_community.document_loaders import DirectoryLoader, TextLoader
from langchain_core.documents import Document

# Load documents from the 'docs' directory
# Using TextLoader explicitly for plain text files with 'latin-1' encoding to handle potential decoding errors
loader = DirectoryLoader(docs_dir, glob="**/doc_*.txt", loader_cls=TextLoader, loader_kwargs={'encoding': 'latin-1'})
documents = loader.load()

print(f"Loaded {len(documents)} documents.")
# Display the first document's content (or a truncated version)
if documents:
    print("\nContent of the first document:")
    print(documents[0].page_content[:200] + "...")
else:
    print("No documents loaded.")

from langchain_text_splitters import RecursiveCharacterTextSplitter

# Initialize the text splitter
text_splitter = RecursiveCharacterTextSplitter(
    chunk_size=500, # Max size of each chunk
    chunk_overlap=50, # Overlap between chunks to maintain context
    separators=["\n\n", "\n", ".", " ", ""]
)

# Split the documents into chunks
chunks = text_splitter.split_documents(documents)

print(f"Split {len(documents)} documents into {len(chunks)} chunks.")
# Display the first chunk's content
if chunks:
    print("\nContent of the first chunk:")
    print(chunks[0].page_content)
else:
    print("No chunks created.")


from langchain_community.embeddings import SentenceTransformerEmbeddings

# Initialize the embedding model
embedding_function = SentenceTransformerEmbeddings(model_name="all-MiniLM-L6-v2")

print("Embedding model initialized: all-MiniLM-L6-v2")


from langchain_community.vectorstores import Chroma

# Create a ChromaDB vector store from the chunks and embeddings
# We'll store it in a persistent directory named 'chroma_db'
vectorstore = Chroma.from_documents(
    documents=chunks,
    embedding=embedding_function,
    persist_directory="./chroma_db"
)

# Persist the collection to disk
vectorstore.persist()
print("ChromaDB collection created and saved to './chroma_db'.")
print(f"Number of embeddings stored: {vectorstore._collection.count()}")
